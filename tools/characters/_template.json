{
  "id": "template",
  "name": "新角色（改这里）",
  "note": "复制这份模板后按顺序调：parts → anchors → scale → measure → report。坐标全是『原始部件像素』，不用先缩放。",

  "parts": {
    "dir": "tools/ref/rig/template_parts",
    "files": {
      "head": "head.png",
      "torso": "torso.png",
      "arm_l": "arm_l.png",
      "arm_r": "arm_r.png",
      "leg_l": "leg_l.png",
      "leg_r": "leg_r.png",
      "shoe_l": "shoe_l.png",
      "shoe_r": "shoe_r.png"
    },
    "flip": {
      "head": false,
      "torso": false,
      "arm_l": false,
      "arm_r": false,
      "leg_l": false,
      "leg_r": false,
      "shoe_l": false,
      "shoe_r": false
    },
    "removeStripe": []
  },

  "anchors": {
    "head_neck": [0, 0],
    "torso_collar": [0, 0],
    "torso_sleeve_l": [0, 0],
    "torso_sleeve_r": [0, 0],
    "torso_hip_l": [0, 0],
    "torso_hip_r": [0, 0],
    "arm_cuff": [0, 0],
    "leg_hip": [0, 0],
    "leg_ankle": [0, 0],
    "shoe_opening": [0, 0]
  },

  "scale": {
    "head": 0.64,
    "torso": 0.66,
    "arm": 0.52,
    "shoe": 0.6,
    "leg_x": 0.52,
    "leg_y": 0.84
  },

  "stage": { "w": 400, "h": 600, "origin": [200, 200], "head_dy": 10 },

  "arm": { "amp": 12, "up": 11, "offset_l_x": -4, "offset_r_x": 3 },

  "leg": { "amp": 26, "hip_shift_l_x": -6 },

  "shoe": {
    "tight_crop": true,
    "rotate_with_leg": true,
    "align_dx": { "l": 0, "r": 0 },
    "forward_dx": 9,
    "dy": { "l": 0, "r": 0 }
  },

  "measure": { "band": 14, "cuffBand": 10, "dark": 70 },

  "bob": 7,

  "cell": {
    "w": 320,
    "h": 460,
    "ground_y": 452,
    "body_h": 408,
    "crop": [70, 80, 330, 465]
  },

  "sheet": {
    "png": "assets/template.png",
    "webp": "assets/template.webp",
    "webp_quality": 92,
    "frames": 16,
    "cols": 17,
    "rows": 2
  },

  "layerVariants": {
    "shoesidle": { "kind": "shoes", "swapOrder": true, "mirrorFront": false }
  },

  "rows": [
    {
      "name": "朝左（上行）",
      "layers": [
        {
          "group": [
            { "src": "armfar" },
            {
              "group": [
                { "src": "legsonly" },
                { "src": "shoes", "flip": true },
                { "src": "torso", "flip": true }
              ]
            }
          ]
        },
        { "src": "armnear" }
      ]
    },
    {
      "name": "朝右（下行）",
      "layers": [
        {
          "group": [
            { "src": "armfar", "flip": true },
            {
              "group": [
                { "src": "legsonly", "flip": true },
                { "src": "shoes" },
                { "src": "torso" }
              ]
            }
          ]
        },
        { "src": "armnear", "flip": true }
      ]
    }
  ],

  "idle": {
    "useFrame": 0,
    "override": { "shoes": "shoesidle" }
  }
}
